# ── Server ────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173

# ── Email (Nodemailer) ────────────────────────────────────
# Use Gmail App Password or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
NOTIFY_TO=your_gmail_address@gmail.com

# ── Resume ────────────────────────────────────────────────
# Either a public URL to the PDF, or leave blank to serve /public/resume.pdf
RESUME_URL=https://yourdomain.com/resume.pdf
