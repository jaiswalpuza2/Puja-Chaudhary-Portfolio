# ── Dependencies ──────────────────────────────────────────────────────────────
# Matches node_modules/ at any depth (root, client/, server/)
node_modules/

# ── Environment / secrets ─────────────────────────────────────────────────────
# Matches .env at any depth (server/.env, client/.env, etc.)
# .env.example files are intentionally NOT ignored — they're safe templates.
.env
.env.local
.env.*.local

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
client/dist/
server/dist/

# ── Lock files (let each environment generate its own) ────────────────────────
package-lock.json
client/package-lock.json
server/package-lock.json

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.suo
*.user

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Misc ──────────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo